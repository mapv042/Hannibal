# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Redis
REDIS_URL=redis://localhost:6379

# Token ceiling for one assistant turn (both providers). Reasoning tokens count
# against this too, so raise it if you see llm_response_incomplete in the logs.
AI_MAX_OUTPUT_TOKENS=4096

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional)
OPEN_AI_KEY=sk-...
OPEN_AI_MODEL=gpt-4.1-mini
# none | low | medium | high | xhigh | max. Only reaches reasoning-first models
# (gpt-5.6+, o-series), which are the ones routed to /v1/responses.
OPEN_AI_REASONING_EFFORT=low
# Strict function calling (arguments guaranteed to match each tool schema).
# Only turn off if a model rejects the strict dialect.
OPENAI_STRICT_TOOLS=true

# Seconds the webhook waits for the rest of a message burst before answering it
# as one turn. 0 answers every message on its own.
MESSAGE_COALESCE_SECONDS=2.5

# Meta/WhatsApp
META_VERIFY_TOKEN=your-custom-string
META_APP_SECRET=from-meta-developers
META_APP_ID=from-meta-developers
# 2FA PIN used when registering numbers for Cloud API (Embedded Signup).
# Pick 6 digits and keep them stable once doctors are onboarded.
META_REGISTER_PIN=000000

# Twilio (optional)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Google OAuth (optional)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=...

# Deployment environment: "development" | "production".
# In production the app refuses to start with empty/placeholder secrets below.
ENVIRONMENT=development

# Security
ENCRYPTION_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32
JWT_SECRET=your-supabase-jwt-secret
# Supabase access-token audience (verified on decode); leave as-is unless customized
JWT_AUDIENCE=authenticated

# Error tracking (optional)
SENTRY_DSN=

# Celery (uses Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend public URL (used to build the Google Calendar push webhook address)
BACKEND_URL=https://your-backend.up.railway.app
