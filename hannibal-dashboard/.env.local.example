# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "anon public" key from Supabase > Settings > API.
# Never put the service_role key here: NEXT_PUBLIC_ vars are inlined into the
# browser bundle, and service_role bypasses RLS (full access to every office).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Meta WhatsApp Embedded Signup
# App ID from developers.facebook.com; config ID from the Embedded Signup
# configuration (WhatsApp > Tech Provider onboarding, visible once verified).
NEXT_PUBLIC_META_APP_ID=from-meta-developers
NEXT_PUBLIC_META_ES_CONFIG_ID=from-embedded-signup-config
